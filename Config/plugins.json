      "Arguments": "-a",
      "LoggingBehavior": "StandardOut",
      "SafetyLevel": "LOW"
    },
    {
      "Id": "testdisk",
      "Name": "TestDisk Partition & File Carver",
      "Category": "Data Recovery",
      "Description": "Open-source partition table repair and deleted file recovery software.",
      "Version": "7.2",
      "License": "GPL-2.0+",
      "SourceUrl": "https://www.cgsecurity.org/wiki/TestDisk",
      "Executable": "Tools/testdisk_win.exe",
      "RequiredPrivileges": "Administrator",
      "SupportedEnvironment": "WinPE, Windows 10, Windows 11",
      "Arguments": "",
      "LoggingBehavior": "FileLog",
      "SafetyLevel": "MEDIUM"
    },
    {
      "Id": "memtest86plus",
      "Name": "MemTest86+ Bootable Memory Diagnostic",
      "Category": "Hardware Diagnostics",
      "Description": "Stand-alone open-source memory test for x86/x64 architecture architecture.",
