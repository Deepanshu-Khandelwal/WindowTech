{
  "Plugins": [
    {
      "Id": "smartctl",
      "Name": "smartctl SMART Diagnostic Engine",
      "Category": "Diagnostics",
      "Description": "Open-source drive SMART health diagnostic tool and defect log analyzer.",
      "Version": "7.4",
      "License": "GPL-2.0",
      "SourceUrl": "https://www.smartmontools.org",
      "Executable": "Tools/smartctl.exe",
      "RequiredPrivileges": "Administrator",
